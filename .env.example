# ============================================================
# SWASA Attendance System — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit your .env file to version control.
# ============================================================

# ----------------------------------------------------------
# Django core
# ----------------------------------------------------------
# Generate a strong secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-very-long-random-secret-key-here

# Set to False in production
DJANGO_DEBUG=False

# ----------------------------------------------------------
# Allowed hosts (comma-separated extra hosts beyond defaults)
# Defaults already include localhost, .pythonanywhere.com, .ngrok-free.dev
# Add your specific PA username here:
# ----------------------------------------------------------
ALLOWED_HOSTS=yourpausername.pythonanywhere.com

# ----------------------------------------------------------
# JWT signing key (defaults to DJANGO_SECRET_KEY if omitted)
# Use a separate key for extra security
# ----------------------------------------------------------
# JWT_SECRET_KEY=another-long-random-key

# ----------------------------------------------------------
# Database — leave blank to use SQLite (dev only)
# For production use Supabase or another PostgreSQL provider
# ----------------------------------------------------------
# DATABASE_URL=postgresql://user:password@host:port/dbname

# ----------------------------------------------------------
# Gmail SMTP — How to get a Gmail App Password
# ----------------------------------------------------------
# You need a Gmail App Password (NOT your regular Gmail password).
# Google blocks plain passwords for SMTP when 2FA is enabled.
#
# Steps:
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Go to App Passwords: https://myaccount.google.com/apppasswords
#   3. Select "Mail" + "Other" (name it "SWASA")
#   4. Copy the 16-character password — remove spaces before pasting below
#
# Leave blank to fall back to the console backend (prints to terminal)
# ----------------------------------------------------------
EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password-no-spaces

# Optional — the sender name shown in emails
DEFAULT_FROM_EMAIL=SWASA Attendance <your-gmail-address@gmail.com>
